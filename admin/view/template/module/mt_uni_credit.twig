{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="float-end">
				<button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
				<a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		<form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
			<div class="row">
				<div class="col-md-8">
					<div class="card mb-3">
						<div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
						<div class="card-body">
							<div class="row mb-3">
								<label class="col-sm-3 col-form-label" for="input-status">{{ entry_status }}</label>
								<div class="col-sm-9">
									<div class="form-check form-switch form-switch-lg">
										<input type="hidden" name="module_mt_uni_credit_status" value="0"/>
										<input type="checkbox" name="module_mt_uni_credit_status" value="1" id="input-status" class="form-check-input"{% if module_mt_uni_credit_status %} checked{% endif %}/>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-4">
					<div class="card">
						<div class="card-header"><i class="fa-solid fa-circle-info"></i> {{ text_health }}</div>
						<div class="card-body">
							<p class="text-muted small">{{ text_health_placeholder }}</p>
							<dl class="row mb-0">
								<dt class="col-sm-6">{{ text_version }}</dt>
								<dd class="col-sm-6">{{ health.version }}</dd>
								<dt class="col-sm-6">{{ text_extension_code }}</dt>
								<dd class="col-sm-6"><code>{{ health.extension_code }}</code></dd>
								<dt class="col-sm-6">{{ entry_status }}</dt>
								<dd class="col-sm-6">{% if health.module_enabled %}{{ text_enabled }}{% else %}{{ text_disabled }}{% endif %}</dd>
								<dt class="col-sm-6">{{ text_cp_endpoint }}</dt>
								<dd class="col-sm-6">
									{% if health.control_panel_configured and health.control_panel_host %}
										{{ health.control_panel_host }}
									{% else %}
										{{ text_health_status_missing }}
									{% endif %}
								</dd>
								<dt class="col-sm-6">{{ text_environment_config }}</dt>
								<dd class="col-sm-6">{{ health.environment_status_label }}</dd>
								<dt class="col-sm-6">{{ text_secret_config }}</dt>
								<dd class="col-sm-6">{{ health.secrets_status_label }}</dd>
								<dt class="col-sm-6">{{ text_certificate }}</dt>
								<dd class="col-sm-6">{{ health.certificate_status_label }}</dd>
								<dt class="col-sm-6">{{ text_private_key }}</dt>
								<dd class="col-sm-6">{{ health.private_key_status_label }}</dd>
								<dt class="col-sm-6">{{ text_certificate_validity }}</dt>
								<dd class="col-sm-6">
									{{ health.certificate_validity_label }}
									{% if health.certificate_not_after %}
										<br><span class="text-muted small">{{ text_certificate_not_after }}: {{ health.certificate_not_after }}</span>
									{% endif %}
								</dd>
								<dt class="col-sm-6">{{ text_certificate_key_match }}</dt>
								<dd class="col-sm-6">{{ health.certificate_key_match_label }}</dd>
								<dt class="col-sm-6">{{ text_deployment_ready }}</dt>
								<dd class="col-sm-6">{% if health.deployment_ready %}{{ text_yes }}{% else %}{{ text_no }}{% endif %}</dd>
							</dl>
						</div>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>
{{ footer }}
