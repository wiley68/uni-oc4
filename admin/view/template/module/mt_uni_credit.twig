{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="float-end">
				<button type="submit" form="form-module" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
				<a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		{% if success %}
			<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
		{% endif %}
		{% if error_warning %}
			<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
		{% endif %}
		<form id="form-module" action="{{ save }}" method="post" data-oc-toggle="ajax">
			<div class="card">
				<div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
				<div class="card-body">
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label" for="input-status">{{ entry_status }}</label>
						<div class="col-sm-9">
							<div class="form-check form-switch form-switch-lg">
								<input type="hidden" name="module_mt_uni_credit_status" value="0"/>
								<input type="checkbox" name="module_mt_uni_credit_status" value="1" id="input-status" class="form-check-input"{% if module_mt_uni_credit_status %} checked{% endif %}/>
							</div>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label" for="input-unicid">{{ entry_unicid }}</label>
						<div class="col-sm-9">
							<input type="text" name="module_mt_uni_credit_unicid" value="{{ module_mt_uni_credit_unicid }}" maxlength="36" id="input-unicid" class="form-control" required/>
							<div class="form-text">{{ help_unicid }}</div>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label" for="input-secret">{{ entry_secret }}</label>
						<div class="col-sm-9">
							<input type="password" name="module_mt_uni_credit_secret" value="" maxlength="64" autocomplete="new-password" id="input-secret" class="form-control"{% if not has_secret %} required{% endif %}/>
							<div class="form-text">{{ help_secret }}{% if has_secret %} {{ text_secret_keep_current }}{% endif %}</div>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label" for="input-advertising">{{ entry_advertising_enabled }}</label>
						<div class="col-sm-9">
							<div class="form-check form-switch form-switch-lg">
								<input type="hidden" name="module_mt_uni_credit_advertising_enabled" value="0"/>
								<input type="checkbox" name="module_mt_uni_credit_advertising_enabled" value="1" id="input-advertising" class="form-check-input"{% if module_mt_uni_credit_advertising_enabled %} checked{% endif %}/>
							</div>
							<div class="form-text">{{ help_advertising_enabled }}</div>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label" for="input-debug">{{ entry_debug_enabled }}</label>
						<div class="col-sm-9">
							<div class="form-check form-switch form-switch-lg">
								<input type="hidden" name="module_mt_uni_credit_debug_enabled" value="0"/>
								<input type="checkbox" name="module_mt_uni_credit_debug_enabled" value="1" id="input-debug" class="form-check-input"{% if module_mt_uni_credit_debug_enabled %} checked{% endif %}/>
							</div>
							<div class="form-text">{{ help_debug_enabled }}</div>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label" for="input-product-button-action">{{ entry_product_button_action }}</label>
						<div class="col-sm-9">
							<select name="module_mt_uni_credit_product_button_action" id="input-product-button-action" class="form-select">
								{% for action in product_button_actions %}
									<option value="{{ action.value }}"{% if module_mt_uni_credit_product_button_action == action.value %} selected{% endif %}>{{ action.label }}</option>
								{% endfor %}
							</select>
							<div class="form-text">{{ help_product_button_action }}</div>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label" for="input-button-top-spacing">{{ entry_button_top_spacing }}</label>
						<div class="col-sm-9">
							<input type="number" name="module_mt_uni_credit_button_top_spacing" value="{{ module_mt_uni_credit_button_top_spacing }}" min="0" max="200" step="1" id="input-button-top-spacing" class="form-control" style="max-width:8rem;"/>
							<div class="form-text">{{ help_button_top_spacing }}</div>
						</div>
					</div>
					<div class="d-flex flex-wrap gap-2 align-items-center pt-2">
						<button type="submit" formaction="{{ refresh_bank_data }}" formmethod="post" formnovalidate form="form-refresh-bank" name="mt_uni_credit_refresh_bank" value="1" class="btn btn-outline-primary">
							<i class="fa-solid fa-rotate"></i> {{ button_refresh_bank_data }}
						</button>
						<button type="submit" formaction="{{ download_journal }}" formmethod="post" formnovalidate form="form-download-journal" class="btn btn-outline-secondary">
							<i class="fa-solid fa-download"></i> {{ button_download_journal }}
						</button>
					</div>
					<div class="form-text mt-2">{{ help_download_journal }}</div>
				</div>
			</div>
		</form>
		<form id="form-refresh-bank" action="{{ refresh_bank_data }}" method="post" class="d-none" aria-hidden="true"></form>
		<form id="form-download-journal" action="{{ download_journal }}" method="post" class="d-none" aria-hidden="true"></form>
	</div>
</div>
{{ footer }}
