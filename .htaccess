# Development-only paths must not be served from the public extension tree.
<IfModule mod_authz_core.c>
    <FilesMatch "^(composer\.(json|lock)|phpunit\.xml)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(vendor|tests|docs|scripts)/ - [F,L]
    RewriteRule ^\.phpunit\.cache/ - [F,L]
</IfModule>
